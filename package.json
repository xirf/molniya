    "traceability": "bun run scripts/traceability.ts",
    "mutation": "bun run scripts/mutation.ts",
    "check": "bun run typecheck && biome check . && bun run build && bun run coverage && bun run traceability && bun run mutation",
    "benchmark": "bun run scripts/benchmark.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
