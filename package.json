{
  "name": "molniya",
  "version": "0.3.0",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "docs"
  ],
  "description": "An experimental data query library for Bun",
  "scripts": {
